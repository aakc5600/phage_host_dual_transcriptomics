{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com///nextflow_schema.json",
  "title": " pipeline parameters",
  "description": "",
  "type": "object",
  "properties": {
    "sampleDict": {
      "type": "string",
      "pattern": "^(false)$|^((?:GSM\\d*:\\d*_\\w*, )*(?:GSM\\d*:\\d*_\\w*))?$"
    },
    "pwd": {
      "type": "string",
      "default": "/ceph/ibmi/it/thesis_data/mangler/git/phage_host_dual_transcriptomics/pipeline",
      "format": "directory-path"
    },
    "hostGenome": {
      "type": "string",
      "default": "/ceph/ibmi/it/thesis_data/mangler/git/phage_host_dual_transcriptomics/pipeline/input/genomes/*host.fna",
      "pattern": "^((\\/[\\w\\*\\.]+)+)$"
    },
    "phageGenome": {
      "type": "string",
      "default": "/ceph/ibmi/it/thesis_data/mangler/git/phage_host_dual_transcriptomics/pipeline/input/genomes/*phage.fna",
      "pattern": "^((\\/[\\w\\*\\.]+)+)$"
    },
    "hostGFF": {
      "type": "string",
      "default": "/ceph/ibmi/it/thesis_data/mangler/git/phage_host_dual_transcriptomics/pipeline/input/genomes/*host.gff",
      "pattern": "^((\\/[\\w\\*\\.]+)+)$"
    },
    "phageGFF": {
      "type": "string",
      "default": "/ceph/ibmi/it/thesis_data/mangler/git/phage_host_dual_transcriptomics/pipeline/input/genomes/*phage.gff",
      "pattern": "^((\\/[\\w\\*\\.]+)+)$"
    },
    "pairedEnd": {
      "type": "boolean"
    },
    "geo": {
      "type": "string",
      "pattern": "^(false)$|^(\\w{3,5}\\d{5,9})( (\\w{3,5}\\d{5,9}))*$"
    },
    "reads": {
      "type": "string",
      "default": "/ceph/ibmi/it/thesis_data/mangler/git/phage_host_dual_transcriptomics/pipeline/input/reads/*.fastq.gz",
      "pattern": "^((\\/[\\w\\*\\.]+)+)$"
    },
    "outputDir": {
      "type": "string",
      "default": "/output"
    },
    "adapter1": {
      "type": "string",
      "default": "AGATCGGAAGAGCACACGTCTGAACTCCAGTCA"
    },
    "adapter2": {
      "type": "string",
      "default": "AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT"
    },
    "countFeature": {
      "type": "string",
      "default": "gene"
    },
    "featureIdentifier": {
      "type": "string",
      "default": "ID"
    },
    "verboseHelp": {
      "type": "boolean"
    },
    "auto": {
      "type": "boolean"
    },
    "metaPath": {
      "type": "string",
      "pattern": "^((\\/[\\w\\*\\.]+)+)$"
    },
    "timeStart": {
      "type": "integer",
      "default": 0
    },
    "timeEnd": {
      "type": "integer",
      "default": 20
    },
    "timeUntilMiddle": {
      "type": "integer",
      "default": 5
    },
    "timeUntilLate": {
      "type": "integer",
      "default": 10
    },
    "gbkPath": {
      "type": "string",
      "pattern": "^(false)$|^(.*\\.gbk)$"
    },
    "pharokka": {
      "type": "boolean"
    },
    "phold": {
      "type": "boolean"
    },
    "phynteny": {
      "type": "boolean"
    },
    "pha_db": {
      "type": "string",
      "pattern": "^(false)$|^((\\/[\\w\\*\\.]+)+\\/?)$"
    },
    "pho_db": {
      "type": "string",
      "pattern": "^(false)$|^((\\/[\\w\\*\\.]+)+\\/?)$"
    },
    "phy_model": {
      "type": "string",
      "pattern": "^(false)$|^((\\/[\\w\\*\\.]+)+\\/?)$"
    },
    "user": {
      "type": "string",
      "default": "mangler"
    },
    "conda_path": {
      "type": "string",
      "default": "/ceph/ibmi/it/thesis_data/mangler/miniforge3/envs",
      "pattern": "^(\\/[\\w\\*\\.]+)+/envs$"
    },
    "mamba": {
      "type": "string",
      "default": "/ceph/ibmi/it/thesis_data/mangler/miniforge3",
      "pattern": "^((\\/[\\w\\*\\.]+)+\\/?)$"
    },
    "threads": {
      "type": "integer",
      "default": 16
    },
    "mem": {
      "type": "integer",
      "default": 2
    },
    "skipValidation": {
      "type": "boolean"
    }
  },
  "required": [
    "hostGenome",
    "phageGenome",
    "hostGFF",
    "phageGFF",
    "adapter1",
    "adapter2",
    "countFeature",
    "featureIdentifier",
    "conda_path",
    "threads",
    "mem",
    "reads"
  ]
}
