// References used in configs & process

params {
    // Defaults
    pubDirMode              = "copy"

    // Input Manager
    hostGenome              = '/home/darthplayer01/ncbi/genomes/GCF_000005845.2_ASM584v2_genomic.fna'
    phageGenome             = '/home/darthplayer01/ncbi/genomes/GCF_000836945.1_ViralProj14044_genomic.fna'
    hostGFF                 = '/home/darthplayer01/ncbi/genomes/GCF_000005845.2_ASM584v2_genomic.gff' 
    phageGFF                = '/home/darthplayer01/ncbi/genomes/GCF_000836945.1_ViralProj14044_genomic.gff'

    pairedEnd               = false //if calling --pairedEnd, read pairs will be collected

    reads                   = '/home/darthplayer01/ncbi/fastqdumps/split-3/SRR21013136.fast*'
    outputDir               = "/output"

    adapter1                = "AGATCGGAAGAGCACACGTCTGAACTCCAGTCA"
    adapter2                = "AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT"

    countFeature            = "gene"
    featureIdentifier       = "ID"

    help                    = false

    // Conda environments
    user = env('USER')
    conda_path = "/home/${params.user}/miniconda3/envs" // e.g. /home/user/miniconda3/envs --> important to direct down until envs directory
}
